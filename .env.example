# =============================================================================
# AXION AUDIT — .env.example  (contrat 02 §30.3 + 30.4, invariant : EXHAUSTIF)
# =============================================================================
# RÈGLE ABSOLUE (02 §30.4-1) : ce fichier documente CHAQUE variable — nom, usage,
# comment la générer — SANS AUCUNE VALEUR RÉELLE. Le `.env` est gitignoré.
# Sur le serveur : /opt/axion-audit/.env, propriétaire root, chmod 600, provisionné
# À LA MAIN par SSH au lot L0 (PAS par la CI), sauvegardé CHIFFRÉ (age/gpg) dans la
# Storage Box — sinon un PRA restaure une infra sans ses clés.
#
# SÉPARATION STRICTE staging / prod (02 §30.4-4) : bases, buckets, clés JWT et clés
# API DISTINCTES. Un secret de staging ne peut RIEN sur la prod.
#
# Génération d'un secret 64 octets :   openssl rand -hex 64
# Génération d'un mot de passe fort :  openssl rand -base64 32
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CONTEXTE D'EXÉCUTION
# -----------------------------------------------------------------------------
# `development` en local, `production` pour les images staging ET prod (c'est le
# mode de build Node). L'environnement logique est APP_ENV, pas NODE_ENV.
NODE_ENV=development
# dev | staging | prod — pilote les garde-fous applicatifs (ex. `pnpm seed:demo`
# est REFUSÉ si APP_ENV=prod — contrat 11 §5, « jamais exécutable en prod »).
APP_ENV=dev
# Niveau pino : fatal|error|warn|info|debug|trace. `info` en prod.
LOG_LEVEL=debug
# Domaine public unique servi par Caddy. Rappel 11 §2 : PAS DE CORS — field, hq et
# l'API sont sous le MÊME domaine (`/` → field, `/hq` → hq, `/api` → API).
PUBLIC_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# 2. API (apps/api)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
# Fuseau serveur : TOUJOURS UTC (invariant 5 ; le fuseau de mission ne sert qu'à
# l'affichage). Ne pas changer.
TZ=UTC

# -----------------------------------------------------------------------------
# 3. POSTGRESQL 16 — secret §30.3 « DATABASE_URL (mdp Postgres) »
# -----------------------------------------------------------------------------
# Réseau Docker INTERNE uniquement (06 §10.3) : jamais publié sur l'hôte en
# staging/prod ; l'admin passe par un tunnel SSH.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=axion_audit
POSTGRES_USER=axion
# openssl rand -base64 32
POSTGRES_PASSWORD=__CHANGEME__
# Construite à partir des 5 variables ci-dessus. Consommée par l'API, le worker et
# drizzle-kit.
DATABASE_URL=postgresql://axion:__CHANGEME__@postgres:5432/axion_audit
# Base dédiée aux tests d'intégration (Testcontainers en fabrique une jetable ; cette
# valeur ne sert qu'au débogage local).
DATABASE_URL_TEST=postgresql://axion:__CHANGEME__@localhost:5432/axion_audit_test

# -----------------------------------------------------------------------------
# 4. REDIS 7 — secret §30.3 « REDIS_PASSWORD » (files BullMQ)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# openssl rand -base64 32
REDIS_PASSWORD=__CHANGEME__
REDIS_URL=redis://:__CHANGEME__@redis:6379

# -----------------------------------------------------------------------------
# 5. MINIO — secret §30.3 « MINIO_ROOT_USER/PASSWORD + clés applicatives »
# -----------------------------------------------------------------------------
# INTERDICTION (11 §2) : MinIO n'est JAMAIS exposé publiquement. Réseau Docker
# interne ; tout download passe par l'API (streaming + RBAC), tout upload par le
# protocole de chunks §9.6.
MINIO_ROOT_USER=__CHANGEME__
# openssl rand -base64 32
MINIO_ROOT_PASSWORD=__CHANGEME__
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Clés APPLICATIVES (moindre accès §30.4-7) : créées par `mc admin user add` au
# provisionnement, restreintes aux seuls buckets ci-dessous. JAMAIS les clés root.
MINIO_ACCESS_KEY=__CHANGEME__
MINIO_SECRET_KEY=__CHANGEME__
# Un bucket par nature de contenu (rétentions RGPD différentes — 06 §10.4).
MINIO_BUCKET_ATTACHMENTS=axion-attachments
MINIO_BUCKET_REPORTS=axion-reports
MINIO_BUCKET_TEMPLATES=axion-templates

# -----------------------------------------------------------------------------
# 6. AUTHENTIFICATION — secrets §30.3 « JWT_ACCESS_SECRET / JWT_REFRESH_SECRET »
# -----------------------------------------------------------------------------
# DEUX secrets DISTINCTS de 64 octets aléatoires (§30.3). Les réutiliser l'un pour
# l'autre annulerait la détection de réutilisation de refresh token (06 §10.1).
# openssl rand -hex 64
JWT_ACCESS_SECRET=__CHANGEME__
JWT_REFRESH_SECRET=__CHANGEME__
# Contrat 11 §3 : access 15 min, refresh 30 j rotatif. Ne pas allonger sans décision.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Rotation (§30.4-6) : changer un secret JWT INVALIDE toutes les sessions — heures
# creuses uniquement, jamais un jour de collecte terrain.

# -----------------------------------------------------------------------------
# 7. CHIFFREMENT APPLICATIF — secret §30.3 « APP_ENCRYPTION_KEY »
# -----------------------------------------------------------------------------
# Chiffre les valeurs sensibles d'`app_settings` (AES — 06 §10.2). 32 octets.
# openssl rand -hex 32
APP_ENCRYPTION_KEY=__CHANGEME__

# -----------------------------------------------------------------------------
# 8. LLM — secret §30.3 « ANTHROPIC_API_KEY » (WORKER UNIQUEMENT)
# -----------------------------------------------------------------------------
# Moindre accès (§30.4-7) : cette clé n'existe QUE dans le conteneur worker, jamais
# dans l'API ni dans un front. Utilisée au lot L11 (Phase 2).
# Rappel 06 §10.4 : les identités ne partent JAMAIS au LLM (pseudonymisation 2 passes).
ANTHROPIC_API_KEY=__CHANGEME__
# Plafond de coût par mission (garde-fou « coûts LLM dérivants », 07 §14), en euros.
LLM_COST_CAP_PER_MISSION_EUR=50

# -----------------------------------------------------------------------------
# 9. WEBHOOKS CONSOLE axion-ia.com — secret §30.3 « CONSOLE_WEBHOOK_SECRET »
# -----------------------------------------------------------------------------
# Secret HMAC PARTAGÉ, généré côté console. Signature + anti-rejeu (lot L13).
CONSOLE_WEBHOOK_SECRET=__CHANGEME__
# Rotation à double clé (§30.4-6) : l'ancienne valeur reste acceptée 24 h. Laisser
# vide hors fenêtre de rotation.
CONSOLE_WEBHOOK_SECRET_PREVIOUS=
CONSOLE_BASE_URL=https://console.example.invalid
# Fenêtre d'acceptation du timestamp signé, en secondes (anti-rejeu).
CONSOLE_WEBHOOK_TOLERANCE_SECONDS=300

# -----------------------------------------------------------------------------
# 10. ALERTES D'EXPLOITATION — secret §30.3 « SMTP_* ou TELEGRAM_BOT_TOKEN »
# -----------------------------------------------------------------------------
# Canal interne Axion-IA existant : Telegram (02 §11.3).
TELEGRAM_BOT_TOKEN=__CHANGEME__
TELEGRAM_CHAT_ID=__CHANGEME__
# Alternative/complément SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertes@example.invalid
# Seuils d'alerte (02 §11.3) : disque, durée d'un job LLM, expiration de certificat.
ALERT_DISK_USAGE_PERCENT=80
ALERT_LLM_JOB_MAX_MINUTES=5
ALERT_CERT_EXPIRY_DAYS=15
# Invariant 8 : alerte « sync muette » au-delà de ce délai (en heures ouvrées).
ALERT_SYNC_SILENT_HOURS=24

# -----------------------------------------------------------------------------
# 11. SAUVEGARDES HORS SERVEUR — secret §30.3 « STORAGE_BOX_* » (root)
# -----------------------------------------------------------------------------
# Règle 3-2-1 (02 §11.4) : Storage Box Hetzner (site distinct) + 2e copie hebdo
# HORS Hetzner. Ces variables vivent dans le .env root du serveur, pas dans les images.
STORAGE_BOX_HOST=
STORAGE_BOX_USER=
STORAGE_BOX_PORT=23
STORAGE_BOX_PATH=/home/axion-audit
STORAGE_BOX_SSH_KEY_PATH=/root/.ssh/storagebox_ed25519
# Copie hebdomadaire hors Hetzner (ex. Scaleway) — rclone.
OFFSITE_RCLONE_REMOTE=
OFFSITE_RCLONE_PATH=
# Rétention (02 §11.4).
BACKUP_RETENTION_DAYS=30
# Passphrase de chiffrement des archives de sauvegarde (age/gpg — §30.4-2).
# openssl rand -base64 48
BACKUP_ENCRYPTION_PASSPHRASE=__CHANGEME__

# -----------------------------------------------------------------------------
# 12. PGBACKREST — WAL archiving + pg_dump toutes les 6 h (02 §11.4)
# -----------------------------------------------------------------------------
PGBACKREST_STANZA=axion
PGBACKREST_REPO_PATH=/var/lib/pgbackrest
# Chiffrement du dépôt pgBackRest. openssl rand -base64 48
PGBACKREST_CIPHER_PASS=__CHANGEME__
# Test de restauration AUTOMATIQUE NOCTURNE (02 §11.4 + critère L0) : heure cron UTC.
RESTORE_TEST_CRON=0 3 * * *

# -----------------------------------------------------------------------------
# 13. DOCX — secret §30.3 « DOCXTEMPLATER_LICENSE » (module image)
# -----------------------------------------------------------------------------
# Utilisé au lot L10 (Phase 2).
DOCXTEMPLATER_LICENSE=__CHANGEME__

# -----------------------------------------------------------------------------
# 14. CADDY — TLS automatique
# -----------------------------------------------------------------------------
# En local, laisser `localhost:8080` (pas d'ACME). En staging/prod : le vrai domaine.
CADDY_SITE_ADDRESS=:8080
# Adresse ACME Let's Encrypt (staging/prod uniquement).
CADDY_ACME_EMAIL=

# -----------------------------------------------------------------------------
# 15. SEED (lot L1) — compte fondateur, contrat 11 §5
# -----------------------------------------------------------------------------
# Le seed L1 crée l'admin AVEC `habilitated_at` posé (anti auto-verrouillage §34.4).
SEED_ADMIN_EMAIL=admin@example.invalid
# 12 caractères minimum (06 §10.1). À changer à la première connexion.
SEED_ADMIN_PASSWORD=__CHANGEME__
SEED_ADMIN_FULL_NAME=Administrateur Axion

# -----------------------------------------------------------------------------
# 16. FRONTS (Vite — variables PUBLIQUES, embarquées dans le bundle)
# -----------------------------------------------------------------------------
# ATTENTION : tout `VITE_*` est VISIBLE par l'utilisateur final. Jamais de secret ici.
# Chemin relatif : même domaine, donc pas de CORS (11 §2).
VITE_API_BASE_URL=/api
VITE_APP_ENV=dev
# Injectée par la CI (SHA court) — sert à l'écran « À propos » et au diagnostic de
# mise à jour du service worker (§31).
VITE_APP_VERSION=dev

# =============================================================================
# 17. NON PRÉSENTS DANS CE FICHIER — portés par les GitHub Environments (§30.4-3)
# =============================================================================
# Ces secrets ne vivent JAMAIS sur le serveur ni dans un .env :
#   DEPLOY_SSH_KEY   clé dédiée restreinte, Actions → serveur (§30.3)
#   DEPLOY_HOST      hôte SSH de l'environnement visé
#   DEPLOY_USER      utilisateur de déploiement (non-root)
#   DEPLOY_PATH      /opt/axion-audit
#   GHCR_TOKEN       push/pull d'images (ou GITHUB_TOKEN)
# Portés par les Environments `staging` et `prod` — JAMAIS en secrets de repo
# globaux. L'environnement `prod` exige une APPROBATION MANUELLE avant déploiement.
# =============================================================================

# =============================================================================
# 18. REGISTRE D'IMAGES — variables NON SECRÈTES, requises par les surcharges
#     docker-compose.staging.yml et .prod.yml (02 §30.5 : GHCR comme registre).
# =============================================================================
# Sans ces deux variables, `docker compose config` échoue sur staging et prod :
# ce ne sont pas des secrets, c'est l'adresse des images à tirer.
# Compte ou organisation GitHub propriétaire des images
# (ghcr.io/<GHCR_OWNER>/axion-audit-{api,worker,field,hq}).
GHCR_OWNER=
# Tag à déployer. La CI le positionne (SHA court en staging, tag `v*` en prod) ;
# en local il n'est pas utilisé, les images étant construites depuis les sources.
IMAGE_TAG=latest
