# =============================================================================
# AXION AUDIT — .env.example  (contrat 02 §30.3 + 30.4, invariant : EXHAUSTIF)
# =============================================================================
# RÈGLE ABSOLUE (02 §30.4-1) : ce fichier documente CHAQUE variable — nom, usage,
# comment la générer — SANS AUCUNE VALEUR RÉELLE. Le `.env` est gitignoré.
# Sur le serveur : /opt/axion-audit/.env, propriétaire root, chmod 600, provisionné
# À LA MAIN par SSH au lot L0 (PAS par la CI), sauvegardé CHIFFRÉ (age/gpg) dans la
# Storage Box — sinon un PRA restaure une infra sans ses clés.
#
# SÉPARATION STRICTE staging / prod (02 §30.4-4) : bases, buckets, clés JWT et clés
# API DISTINCTES. Un secret de staging ne peut RIEN sur la prod.
#
# Génération d'un secret 64 octets :   openssl rand -hex 64
# Génération d'un mot de passe fort :  openssl rand -base64 32
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CONTEXTE D'EXÉCUTION
# -----------------------------------------------------------------------------
# `development` en local, `production` pour les images staging ET prod (c'est le
# mode de build Node). L'environnement logique est APP_ENV, pas NODE_ENV.
NODE_ENV=development
# dev | staging | prod — pilote les garde-fous applicatifs (ex. `pnpm seed:demo`
# est REFUSÉ si APP_ENV=prod — contrat 11 §5, « jamais exécutable en prod »).
APP_ENV=dev
# Niveau pino : fatal|error|warn|info|debug|trace. `info` en prod.
LOG_LEVEL=debug
# Domaine public unique servi par Caddy. Rappel 11 §2 : PAS DE CORS — field, hq et
# l'API sont sous le MÊME domaine (`/` → field, `/hq` → hq, `/api` → API).
PUBLIC_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# 2. API (apps/api)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
# Fuseau serveur : TOUJOURS UTC (invariant 5 ; le fuseau de mission ne sert qu'à
# l'affichage). Ne pas changer.
TZ=UTC

# -----------------------------------------------------------------------------
# 3. POSTGRESQL 16 — secret §30.3 « DATABASE_URL (mdp Postgres) »
# -----------------------------------------------------------------------------
# Réseau Docker INTERNE uniquement (06 §10.3) : jamais publié sur l'hôte en
# staging/prod ; l'admin passe par un tunnel SSH.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=axion_audit
POSTGRES_USER=axion
# openssl rand -base64 32
POSTGRES_PASSWORD=__CHANGEME__
# Construite à partir des 5 variables ci-dessus. Consommée par l'API, le worker et
# drizzle-kit.
DATABASE_URL=postgresql://axion:__CHANGEME__@postgres:5432/axion_audit
# Base dédiée aux tests d'intégration (Testcontainers en fabrique une jetable ; cette
# valeur ne sert qu'au débogage local).
DATABASE_URL_TEST=postgresql://axion:__CHANGEME__@localhost:5432/axion_audit_test

# -----------------------------------------------------------------------------
# 4. REDIS 7 — secret §30.3 « REDIS_PASSWORD » (files BullMQ)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# openssl rand -base64 32
REDIS_PASSWORD=__CHANGEME__
REDIS_URL=redis://:__CHANGEME__@redis:6379

# -----------------------------------------------------------------------------
# 5. MINIO — secret §30.3 « MINIO_ROOT_USER/PASSWORD + clés applicatives »
# -----------------------------------------------------------------------------
# INTERDICTION (11 §2) : MinIO n'est JAMAIS exposé publiquement. Réseau Docker
# interne ; tout download passe par l'API (streaming + RBAC), tout upload par le
# protocole de chunks §9.6.
MINIO_ROOT_USER=__CHANGEME__
# openssl rand -base64 32
MINIO_ROOT_PASSWORD=__CHANGEME__
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Clés APPLICATIVES (moindre accès §30.4-7) : créées par `mc admin user add` au
# provisionnement, restreintes aux seuls buckets ci-dessous. JAMAIS les clés root.
MINIO_ACCESS_KEY=__CHANGEME__
MINIO_SECRET_KEY=__CHANGEME__
# Un bucket par nature de contenu (rétentions RGPD différentes — 06 §10.4).
MINIO_BUCKET_ATTACHMENTS=axion-attachments
MINIO_BUCKET_REPORTS=axion-reports
MINIO_BUCKET_TEMPLATES=axion-templates

# -----------------------------------------------------------------------------
# 6. AUTHENTIFICATION — secrets §30.3 « JWT_ACCESS_SECRET / JWT_REFRESH_SECRET »
# -----------------------------------------------------------------------------
# DEUX secrets DISTINCTS de 64 octets aléatoires (§30.3). Les réutiliser l'un pour
# l'autre annulerait la détection de réutilisation de refresh token (06 §10.1).
# openssl rand -hex 64
JWT_ACCESS_SECRET=__CHANGEME__
JWT_REFRESH_SECRET=__CHANGEME__
# Contrat 11 §3 : access 15 min, refresh 30 j rotatif. Ne pas allonger sans décision.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Rotation (§30.4-6) : changer un secret JWT INVALIDE toutes les sessions — heures
# creuses uniquement, jamais un jour de collecte terrain.

# -----------------------------------------------------------------------------
# 7. CHIFFREMENT APPLICATIF — secret §30.3 « APP_ENCRYPTION_KEY »
# -----------------------------------------------------------------------------
# Chiffre les valeurs sensibles d'`app_settings` (AES — 06 §10.2). 32 octets.
# openssl rand -hex 32
APP_ENCRYPTION_KEY=__CHANGEME__

# -----------------------------------------------------------------------------
# 8. LLM — secret §30.3 « ANTHROPIC_API_KEY » (WORKER UNIQUEMENT)
# -----------------------------------------------------------------------------
# Moindre accès (§30.4-7) : cette clé n'existe QUE dans le conteneur worker, jamais
# dans l'API ni dans un front. Utilisée au lot L11 (Phase 2).
# Rappel 06 §10.4 : les identités ne partent JAMAIS au LLM (pseudonymisation 2 passes).
ANTHROPIC_API_KEY=__CHANGEME__
# Plafond de coût par mission (garde-fou « coûts LLM dérivants », 07 §14), en euros.
LLM_COST_CAP_PER_MISSION_EUR=50

# -----------------------------------------------------------------------------
# 9. WEBHOOKS CONSOLE axion-ia.com — secret §30.3 « CONSOLE_WEBHOOK_SECRET »
# -----------------------------------------------------------------------------
# Secret HMAC PARTAGÉ, généré côté console. Signature + anti-rejeu (lot L13).
CONSOLE_WEBHOOK_SECRET=__CHANGEME__
# Rotation à double clé (§30.4-6) : l'ancienne valeur reste acceptée 24 h. Laisser
# vide hors fenêtre de rotation.
CONSOLE_WEBHOOK_SECRET_PREVIOUS=
CONSOLE_BASE_URL=https://console.example.invalid
# Fenêtre d'acceptation du timestamp signé, en secondes (anti-rejeu).
CONSOLE_WEBHOOK_TOLERANCE_SECONDS=300

# -----------------------------------------------------------------------------
# 10. ALERTES D'EXPLOITATION — secret §30.3 « SMTP_* ou TELEGRAM_BOT_TOKEN »
# -----------------------------------------------------------------------------
# Canal interne Axion-IA existant : Telegram (02 §11.3).
TELEGRAM_BOT_TOKEN=__CHANGEME__
TELEGRAM_CHAT_ID=__CHANGEME__
# Alternative/complément SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertes@example.invalid
# Seuils d'alerte (02 §11.3) : disque, durée d'un job LLM, expiration de certificat.
ALERT_DISK_USAGE_PERCENT=80
ALERT_LLM_JOB_MAX_MINUTES=5
ALERT_CERT_EXPIRY_DAYS=15
# Invariant 8 : alerte « sync muette » au-delà de ce délai (en heures ouvrées).
ALERT_SYNC_SILENT_HOURS=24

# -----------------------------------------------------------------------------
# 11. SAUVEGARDES HORS SERVEUR — secret §30.3 « STORAGE_BOX_* » (root)
# -----------------------------------------------------------------------------
# ⚠️ DEUX CHAÎNES DE SAUVEGARDE COEXISTENT DANS CE DÉPÔT, ET CE FICHIER PORTE LES
# VARIABLES DES DEUX. Ne pas les confondre, et surtout ne pas poser les deux jeux
# sur la même machine : elles écriraient toutes les deux dans le même dépôt
# pgBackRest et se voleraient le verrou de stanza chaque nuit (infra/README.md
# §7.4).
#   · CHEMIN « VPS DÉDIÉ » (docker-compose.yml + .staging.yml/.prod.yml) — la
#     sauvegarde vit sur l'HÔTE, dans `cron`, posée par `infra/scripts/
#     install-cron.sh` (4 tâches). Ses variables sont `STORAGE_BOX_*`,
#     `OFFSITE_RCLONE_*` et `RESTORE_TEST_CRON`. **JAMAIS JOUÉ** à ce jour.
#   · CHEMIN COOLIFY (docker-compose.coolify.yml) — pas d'accès à l'hôte, donc
#     pas de `cron` : la sauvegarde est un SERVICE de la pile. Ses variables sont
#     les `BACKUP_R2_*` / `AXION_R2_*` / `AXION_SAUVEGARDE_*` plus bas, et
#     `BACKUP_SECRETS_PASSPHRASE` juste après. C'est le chemin ÉPROUVÉ.
# `BACKUP_RETENTION_DAYS`, `BACKUP_ENCRYPTION_PASSPHRASE` et les `PGBACKREST_*`
# servent aux DEUX.
#
# Règle 3-2-1 (02 §11.4) : Storage Box Hetzner (site distinct) + 2e copie hebdo
# HORS Hetzner. Ces variables vivent dans le .env root du serveur, pas dans les images.
STORAGE_BOX_HOST=
STORAGE_BOX_USER=
STORAGE_BOX_PORT=23
STORAGE_BOX_PATH=/home/axion-audit
STORAGE_BOX_SSH_KEY_PATH=/root/.ssh/storagebox_ed25519
# Copie hebdomadaire hors Hetzner (ex. Scaleway) — rclone.
OFFSITE_RCLONE_REMOTE=
OFFSITE_RCLONE_PATH=
# Rétention (02 §11.4).
BACKUP_RETENTION_DAYS=30
# Passphrase de chiffrement des archives de sauvegarde (age/gpg — §30.4-2).
# openssl rand -base64 48
BACKUP_ENCRYPTION_PASSPHRASE=__CHANGEME__
# -----------------------------------------------------------------------------
# COFFRE DES SECRETS — la sauvegarde CHIFFRÉE de ce fichier-ci (02 §30.4-2 :
# « sinon un PRA restaure une infra sans ses clés »).
#
# Le service `sauvegarde` produit à chaque passe un `secrets-*.coffre.gpg` qui
# contient l'ensemble CLÉ=valeur de la pile, part vers le stockage distant avec
# les autres archives et y est RELU pour vérification. Sans lui, une
# restauration rend la base et les pièces jointes — et aucun conteneur ne
# redémarre, faute des clés qui les rouvrent.
#
# ⚠️ PASSPHRASE DÉDIÉE, PAS UNE COPIE DE CELLE DU DESSUS. Bucket distant
# compromis + BACKUP_ENCRYPTION_PASSPHRASE fuitée = les données sont lues ; la
# même fuite sur un coffre chiffré par la même valeur donnerait EN PLUS tous les
# jetons, mots de passe et clés d'API de la pile. Deux niveaux de garde, deux
# clés. Le script REFUSE de retomber en silence sur l'autre passphrase, et le
# dit au journal si les deux sont égales.
#
# ⚠️ CETTE VALEUR DOIT VIVRE HORS DE LA MACHINE (gestionnaire de mots de passe
# de Williams). Elle est dans le coffre comme toutes les autres variables, ce
# qui ne sert à rien : il faut déjà la détenir pour ouvrir le fichier. UNE
# SAUVEGARDE QU'ON NE PEUT DÉCHIFFRER QU'AVEC CE QU'ON A PERDU NE PROTÈGE DE
# RIEN. Tant qu'elle n'est pas posée, le coffre n'est PAS produit et le journal
# du service l'annonce en nommant cette variable.
#
# ⚠️ CE COFFRE N'EXISTE QUE SUR LE CHEMIN COOLIFY. Il est produit par le service
# `sauvegarde`, qui ne figure QUE dans `docker-compose.coolify.yml`. Sur le
# chemin « VPS dédié », poser cette variable NE PRODUIT RIEN : aucun des quatre
# scripts de `infra/scripts/` ne sauvegarde ce fichier, et ce qui en tient lieu
# est une commande affichée UNE FOIS par `provision-vps.sh` (étape 4), à taper à
# la main et jamais rejouée à une rotation de secret. C'est un trou OUVERT, et il
# est décrit tel quel : infra/README.md §7.4-A.
#
# openssl rand -base64 48    (moins de 20 caractères = traité comme absent)
BACKUP_SECRETS_PASSPHRASE=__CHANGEME__

# -----------------------------------------------------------------------------
# 12. PGBACKREST — WAL archiving + pg_dump toutes les 6 h (02 §11.4)
# -----------------------------------------------------------------------------
PGBACKREST_STANZA=axion
PGBACKREST_REPO_PATH=/var/lib/pgbackrest
# Chiffrement du dépôt pgBackRest. openssl rand -base64 48
PGBACKREST_CIPHER_PASS=__CHANGEME__
# Test de restauration AUTOMATIQUE NOCTURNE (02 §11.4 + critère L0) : heure cron UTC.
# ENTRE GUILLEMETS OBLIGATOIREMENT — toute valeur contenant une espace doit être
# citée : les scripts d'exploitation chargent ce fichier par `set -a; . fichier`,
# et bash exécuterait le reste de la ligne comme une commande. Docker Compose,
# lui, tolère la valeur nue — d'où un défaut qui ne se révèle qu'au premier appel
# d'un script, c'est-à-dire sur le VPS.
RESTORE_TEST_CRON="0 3 * * *"

# -----------------------------------------------------------------------------
# 13. DOCX — secret §30.3 « DOCXTEMPLATER_LICENSE » (module image)
# -----------------------------------------------------------------------------
# Utilisé au lot L10 (Phase 2).
DOCXTEMPLATER_LICENSE=__CHANGEME__

# -----------------------------------------------------------------------------
# 14. CADDY — TLS automatique
# -----------------------------------------------------------------------------
# En local, laisser `localhost:8080` (pas d'ACME). En staging/prod : le vrai domaine.
CADDY_SITE_ADDRESS=:8080
# Adresse ACME Let's Encrypt. Les alertes d'expiration de certificat y sont envoyées.
# NE JAMAIS LAISSER VIDE : Caddy n'applique le défaut de son `{$VAR:defaut}` que si la
# variable est ABSENTE, pas si elle est présente et vide — une valeur vide produit
# `email ` et fait échouer l'analyse de la configuration, donc une boucle de
# redémarrage. En local la valeur n'est pas utilisée (`:8080` ne déclenche aucun ACME),
# elle doit seulement exister. En staging/prod : une adresse RÉELLE et relevée.
CADDY_ACME_EMAIL=ops@example.invalid
# --- Second bloc de site : STAGING (02 §11.2 : « même VPS, SOUS-DOMAINE, DB séparée ») ---
# UN SEUL Caddy sert les deux environnements : un seul processus peut lier 443, et un
# sous-domaine implique un certificat, donc un serveur qui écoute. Voir DECISIONS.md
# 2026-08-27 « Cohabitation staging/prod : qui écoute sur 443 ? ».
# Cette variable vit dans le .env de PRODUCTION (c'est la pile de prod qui porte le
# frontal). OBLIGATOIRE sur le VPS : une adresse de site vide empêche Caddy de
# démarrer. En local, :8081 — le bloc staging y est inerte (port non publié).
# Le port interne de l'API est le MÊME dans les deux environnements (convention
# API_PORT=3000) : une variable dont deux copies doivent coïncider à la main est une
# panne en attente, et la panne tomberait sur la PRODUCTION.
CADDY_STAGING_SITE_ADDRESS=:8081

# --- Comment les fronts sont SERVIS (voir DECISIONS.md 2026-08-27) -------------
# En DÉVELOPPEMENT, Caddy proxifie les serveurs Vite : le rechargement à chaud est
# tout l'intérêt du mode dev.
# En STAGING et en PRODUCTION, les images de fronts déposent leur build dans un
# volume et s'arrêtent ; Caddy sert les fichiers lui-même (root + file_server +
# repli SPA). Ce n'est pas une économie de composant : c'est Caddy qui doit
# maîtriser le Cache-Control du service worker et le repli SPA, et ces règles sont
# SANS EFFET derrière un reverse_proxy. La mise à jour applicative §31 et le
# démarrage hors ligne en dépendent directement.
#
# Sur le VPS, cette valeur est IMPOSÉE par la surcharge Compose et non lue ici : le
# mode de service découle de la forme du déploiement (images one-shot + volumes),
# pas d'un réglage d'exploitant. Un .env de production portant « dev » mettrait
# tout le site en 502.
CADDY_FRONT_CONFIG=/etc/caddy/fronts.dev.caddy

# -----------------------------------------------------------------------------
# 15. SEED (lot L1) — compte fondateur, contrat 11 §5
# -----------------------------------------------------------------------------
# Le seed L1 crée l'admin AVEC `habilitated_at` posé (anti auto-verrouillage §34.4).
SEED_ADMIN_EMAIL=admin@example.invalid
# 12 caractères minimum (06 §10.1). À changer à la première connexion.
SEED_ADMIN_PASSWORD=__CHANGEME__
SEED_ADMIN_FULL_NAME="Administrateur Axion"

# -----------------------------------------------------------------------------
# 16. FRONTS (Vite — variables PUBLIQUES, embarquées dans le bundle)
# -----------------------------------------------------------------------------
# ATTENTION : tout `VITE_*` est VISIBLE par l'utilisateur final. Jamais de secret ici.
# Chemin relatif : même domaine, donc pas de CORS (11 §2).
VITE_API_BASE_URL=/api
VITE_APP_ENV=dev
# Injectée par la CI (SHA court) — sert à l'écran « À propos » et au diagnostic de
# mise à jour du service worker (§31).
VITE_APP_VERSION=dev

# =============================================================================
# 17. NON PRÉSENTS DANS CE FICHIER — portés par les GitHub Environments (§30.4-3)
# =============================================================================
# Ces secrets ne vivent JAMAIS sur le serveur ni dans un .env :
#   DEPLOY_SSH_KEY   clé dédiée restreinte, Actions → serveur (§30.3)
#   DEPLOY_HOST      hôte SSH de l'environnement visé
#   DEPLOY_USER      utilisateur de déploiement (non-root)
#   DEPLOY_PATH      chemin de la COPIE DU DÉPÔT sur le serveur — celui où
#                    `cd $DEPLOY_PATH` doit trouver `infra/scripts/`.
#                    Valeur : /opt/axion-audit/repo
#                    ATTENTION : /opt/axion-audit est la racine d'EXPLOITATION
#                    (<env>/.env, <env>.deployed-tags), PAS le dépôt. Les deux ne
#                    sont pas interchangeables ; les workflows échouent désormais
#                    avec un message explicite si DEPLOY_PATH ne contient pas
#                    infra/scripts/deploy.sh.
#   GHCR_TOKEN       push/pull d’images — INUTILE en pratique : le GITHUB_TOKEN du run,
#                    avec `packages: write` accordé au seul job de build, suffit
#                    (§30.3 le prévoit, §30.4-7 le préfère)
#   DEPLOY_SSH_KNOWN_HOSTS  empreinte de l’hôte SSH. Sans elle il faudrait
#                    `StrictHostKeyChecking=no`, c’est-à-dire accepter un homme du
#                    milieu sur le canal qui porte nos déploiements
# Portés par les Environments `staging` et `prod` — JAMAIS en secrets de repo
# globaux. L'environnement `prod` exige une APPROBATION MANUELLE avant déploiement.
# =============================================================================

# =============================================================================
# 18. REGISTRE D'IMAGES — variables NON SECRÈTES, requises par les surcharges
#     docker-compose.staging.yml et .prod.yml (02 §30.5 : GHCR comme registre).
# =============================================================================
# Sans ces deux variables, `docker compose config` échoue sur staging et prod :
# ce ne sont pas des secrets, c'est l'adresse des images à tirer.
# Compte ou organisation GitHub propriétaire des images
# (ghcr.io/<GHCR_OWNER>/axion-audit-{api,worker,field,hq}).
# EN MINUSCULES : GHCR n'accepte pas de majuscule dans un chemin de dépôt. Les
# workflows normalisent leur propre valeur, mais celle du .env serveur est
# prioritaire au chargement et n'est normalisée nulle part — une majuscule ici
# ferait POUSSER les images sous un nom et les TIRER sous un autre.
GHCR_OWNER=
# Reseau Docker du proxy Traefik de Coolify, auquel SEUL notre Caddy s’attache pour etre
# joignable (infra/docker-compose.coolify.yml) - defaut `coolify` ; verifier avec
# `docker network inspect coolify`.
# SEUL `docker-compose.coolify.yml` lit cette variable : aucun effet sur les piles dev,
# staging ou prod. Le reseau est declare `external` - une valeur erronee fait ECHOUER le
# deploiement immediatement, elle ne degrade rien silencieusement.
COOLIFY_PROXY_NETWORK=coolify

# Tag à déployer. La CI le positionne (SHA court en staging, tag `v*` en prod) ;
# en local il n'est pas utilisé, les images étant construites depuis les sources.
IMAGE_TAG=latest

# =============================================================================
# SAUVEGARDE — service `sauvegarde` de docker-compose.coolify.yml (02 §11.4)
# =============================================================================
# Créneau quotidien, EN UTC (invariant 5 : l'heure de mission n'existe qu'à
# l'affichage). Format `HH:MM` strict — le script REFUSE de démarrer sur une
# valeur qu'il ne sait pas lire plutôt que de choisir une heure à votre place.
AXION_SAUVEGARDE_HEURE=02:30
# Jour de la sauvegarde COMPLÈTE, au format `date +%w` (0 = dimanche, 6 = samedi).
# Les autres jours produisent une incrémentale. 02 §11.4 : complète hebdomadaire
# + incrémentale quotidienne. Hors 0-6, le service échoue en le disant.
AXION_SAUVEGARDE_JOUR_COMPLETE=0
# Plafond, en Mo, du volume d'archives MinIO. LA MACHINE EST PARTAGÉE avec la
# production d'un tiers : au-delà de ce plafond le service échoue BRUYAMMENT
# plutôt que de remplir le disque du voisin, et son message nomme l'arbitrage à
# prendre (rétention MinIO ≈ taille de MinIO × nombre d'archives gardées — c'est
# ce poste-là qui décide, pas la base).
AXION_ARCHIVES_MAX_MO=20480

# -----------------------------------------------------------------------------
# ALERTE — LA MOITIÉ DE L'INVARIANT 8 QUI MANQUAIT (« alerte automatique »)
# -----------------------------------------------------------------------------
# La chaîne de sauvegarde était complète et prouvée, et PERSONNE N'ÉTAIT PRÉVENU
# de ses pannes. Deux pièces la referment, et elles sont indépendantes :
#
#   1. LA SONDE DE SANTÉ du service `sauvegarde` — elle ne dépend de personne et
#      d'aucun secret. Elle refuse d'être verte quand la dernière expédition
#      réussie est trop ancienne, ce qui rend la panne visible dans `docker ps`,
#      dans l'interface de Coolify et pour toute supervision qui lit l'état de
#      santé Docker. Seuil ci-dessous.
#   2. LA NOTIFICATION SORTANTE (Telegram, §10 de ce fichier) — elle, dépend du
#      bot que Williams doit créer. Tant que `TELEGRAM_BOT_TOKEN` et
#      `TELEGRAM_CHAT_ID` sont vides, le service DÉMARRE, SAUVEGARDE, EXPÉDIE et
#      écrit au journal que la notification est inactive. Il ne fait pas
#      semblant d'alerter, et il n'échoue pas pour autant.
#
# Ni l'une ni l'autre ne dit quoi que ce soit si LA MACHINE ENTIÈRE EST MORTE :
# les deux s'exécutent dessus. Ce trou-là ne se ferme qu'avec une surveillance
# EXTERNE (02 §11.3 cite Uptime Kuma), qui n'est pas déployée.
#
# Seuil de fraîcheur de la sonde, en heures. 30 = 24 h de période nominale
# + 2 h de tolérance de rattrapage (le service ne fait RIEN en deçà, rougir
# avant qu'il n'agisse serait rougir sur son dos) + 4 h de marge pour la durée
# d'une passe. Le détail est en tête de infra/postgres/sauvegarde-healthcheck.sh.
AXION_SAUVEGARDE_SEUIL_ALERTE_H=30
# -----------------------------------------------------------------------------
# LA SONDE NE SE CONTENTE PLUS DE DEUX ENTIERS (correctif du 2026-08-28)
# -----------------------------------------------------------------------------
# Jusqu'à cette date elle comparait l'ÂGE DE DEUX MARQUEURS à un seuil, et rien
# d'autre : deux `echo $(date +%s)` dans un volume par ailleurs VIDE la rendaient
# VERTE. Elle vérifie désormais aussi les ARTEFACTS — que le dépôt pgBackRest a
# un `backup.info`, qu'une archive MinIO existe, qu'elle est récente, qu'elle a
# une taille plausible, et que son empreinte est bien celle publiée dans le
# `.sha256` voisin. Les trois réglages ci-dessous bornent le seul de ces
# contrôles qui coûte quelque chose.
#
# Plancher de taille d'une archive, en OCTETS. Mesuré sur l'image de la pile :
# 153 octets pour l'archive d'un répertoire vide, 4 341 pour celle d'un volume
# MinIO minimal. 1 Ko sépare « archive de rien / tronquée » de « vraie archive ».
AXION_SAUVEGARDE_ARCHIVE_MIN_O=1024
# Taille au-delà de laquelle la sonde NE RECALCULE PAS l'empreinte, en Mo. Une
# sonde qui hacherait plusieurs gigaoctets toutes les cinq minutes dépasserait le
# `timeout` du compose, serait TUÉE en plein calcul et rendrait le conteneur
# `unhealthy` au hasard — et une sonde qui rougit à tort finit désactivée, ce qui
# vaut moins que pas de sonde du tout. Au-delà du plafond, le verdict DIT que
# l'empreinte n'a pas été vérifiée, au lieu de laisser croire qu'elle l'a été.
AXION_SAUVEGARDE_EMPREINTE_MAX_MO=256
# Délai maximal accordé à ce calcul, en secondes. Doit rester STRICTEMENT
# inférieur au `timeout` du healthcheck du compose (30 s) : la sonde doit rendre
# un verdict, jamais se faire tuer au milieu d'un calcul.
AXION_SAUVEGARDE_EMPREINTE_DELAI_S=10
# -----------------------------------------------------------------------------
# REPRISE DU JOB `createstanza` SUR UN VERROU pgBackRest
# -----------------------------------------------------------------------------
# Le job porte `restart: 'no'` — obligatoire pour un one-shot dont les autres
# services dépendent par `service_completed_successfully` — et ne se relance donc
# JAMAIS seul. Une seule collision de verrou (`unable to acquire lock`, code 50)
# laisserait le cluster sans stanza, donc en boucle de réinitialisation. Ces deux
# valeurs bornent la reprise : 30 tentatives espacées de 5 s = 150 s au plus.
# La reprise ne vise QUE le verrou ; toute autre erreur échoue immédiatement.
AXION_STANZA_TENTATIVES=30
AXION_STANZA_DELAI_S=5
# Anti-harcèlement : délai minimal, en heures, entre deux messages de MÊME
# catégorie. Une panne R2 de trois nuits doit produire TROIS messages (plus un
# de rétablissement), pas un par redémarrage du conteneur — un canal qui hurle
# est un canal qu'on met en sourdine, et une sourdine n'alerte plus personne.
# Un changement de gravité (expédition → sauvegarde) passe outre ce délai.
AXION_ALERTE_INTERVALLE_H=24

# -----------------------------------------------------------------------------
# COPIE HORS SERVEUR — Cloudflare R2 (02 §11.4 règle 3-2-1, invariant 8)
# -----------------------------------------------------------------------------
# SANS CES QUATRE VARIABLES, LA SAUVEGARDE VIT SUR LA MACHINE QU'ELLE PROTÈGE :
# perdre le VPS, c'est perdre les données ET leurs sauvegardes. Elles ne vont
# QU'AU SERVICE `sauvegarde` de docker-compose.coolify.yml — un jeton d'écriture
# sur le bucket de secours n'a rien à faire dans l'API, le worker ou la base.
#
# ⚠️ CHEMIN COOLIFY UNIQUEMENT — voir l'avertissement « DEUX CHAÎNES » du §11.
# Sur le chemin « VPS dédié », la copie hors serveur est faite par `rsync` vers
# la Storage Box depuis `cron` (§11), et LA DESTINATION DÉFINITIVE DE LA
# PRODUCTION N'EST PAS TRANCHÉE : c'est une escalade ouverte, quatre options
# formulées, décision Williams (infra/README.md §5.6). R2 a été retenu pour le
# staging Coolify SOUS CONTRAINTE — pas d'hôte, donc pas de cron. Ne pas en
# déduire que la production ira sur R2.
#
# ⚠️ LAISSER `__CHANGEME__` N'EST PAS NEUTRE. `${VAR:?}` ne teste que le VIDE :
# `__CHANGEME__` le satisfait, la pile démarre, et le contrôle de forme du script
# rejette alors le caractère `_` — le service part en boucle de redémarrage. Ces
# quatre valeurs se posent AVANT le premier déploiement, ou pas du tout.
#
# Elles sont déclarées `${VAR:?…}` dans le compose : si l'une manque, LE
# DÉPLOIEMENT S'ARRÊTE en la nommant, pendant que la pile précédente continue de
# tourner. C'est délibéré — un service de sauvegarde qui démarrerait sans savoir
# où expédier ne se signalerait que le jour où l'on cherche la copie distante.
#
# Bucket DÉDIÉ aux sauvegardes : il ne partage rien avec un autre usage, et le
# jeton qui l'accompagne est limité à ce seul bucket, en lecture/écriture
# d'objets. Aucun droit d'administration de compte, aucun autre bucket.
BACKUP_R2_BUCKET=axion-audit-backups
# Endpoint S3 du compte R2. Le schéma est FACULTATIF (le script normalise et
# force `https` : les identifiants ne voyagent jamais en clair).
#   forme attendue : <identifiant-de-compte>.r2.cloudflarestorage.com
BACKUP_R2_ENDPOINT=__CHANGEME__
# Jeton R2 (« Object Read & Write » sur ce seul bucket). Hexadécimal : le script
# REFUSE de démarrer si la valeur contient un caractère réservé d'URL, parce
# qu'elle entre dans `mc` par une URL (`MC_HOST_<alias>`) et non par la ligne de
# commande — la ligne de commande serait lisible par tout le monde sur l'hôte.
BACKUP_R2_ACCESS_KEY=__CHANGEME__
BACKUP_R2_SECRET_KEY=__CHANGEME__
# Préfixe d'objets DANS le bucket : il sépare les environnements qui
# partageraient la même destination. Sans lui, deux piles expédiant côte à côte
# se mirroiteraient l'une l'autre — et le `--remove` du miroir transformerait la
# collision en suppression. Segment simple, sans `/`.
AXION_R2_PREFIXE=staging
# Relecture de contrôle après chaque expédition : deux objets sont
# RETÉLÉCHARGÉS depuis R2 et leur SHA-256 comparé à celui de la source (la
# dernière archive MinIO et `backup.info`, sans lequel aucune restauration ne
# démarre). « L'envoi a réussi » ne prouve rien. L'egress R2 est facturé zéro :
# seul le temps se paie. `non` la désactive — réglage d'exploitation, pas défaut.
AXION_R2_VERIFIER_RELECTURE=oui
