{
  "name": "axion-audit",
  "version": "0.0.0",
  "private": true,
  "description": "Axion Audit — outil d'audit IA d'Axion-IA SAS. Monorepo pnpm (07 §12, 02 §30.2).",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.11.0 <23",
    "pnpm": ">=9.0.0 <10"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "build": "pnpm --recursive --filter \"./packages/**\" build && pnpm --recursive --filter \"./apps/**\" build",
    "lint": "pnpm build:packages && eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:packages && pnpm --recursive --stream typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:filrouge": "pnpm build && playwright test --grep @filrouge --pass-with-no-tests",
    "test:critique": "vitest run --project unit --project integration -t @critique && playwright test --grep @critique --pass-with-no-tests",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:no-skipped-tests": "node scripts/check-no-skipped-tests.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "check:jonction": "node scripts/check-jonction.mjs",
    "check:pack": "node scripts/check-pack-integrity.mjs",
    "check:decisions": "node scripts/check-decisions.mjs",
    "schema:diff": "node scripts/schema-diff.mjs",
    "check:schema-inventaire": "node scripts/check-schema-inventaire.mjs",
    "db:generate": "pnpm --filter @axion/api db:generate",
    "db:migrate": "pnpm --filter @axion/api db:migrate",
    "db:migrate:check": "pnpm --filter @axion/api db:migrate:check",
    "seed": "pnpm --filter @axion/api seed",
    "seed:demo": "pnpm --filter @axion/api seed:demo",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
    "infra:reset": "docker compose --env-file .env -f infra/docker-compose.yml down -v",
    "infra:config": "docker compose --env-file .env -f infra/docker-compose.yml config -q && echo 'compose dev : syntaxe OK'",
    "infra:restore-test": "bash infra/scripts/restore-test.sh /opt/axion-audit/prod/.env",
    "prepare": "husky",
    "check:test-projects": "node scripts/check-test-projects.mjs",
    "verify": "pnpm build && pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:pack && pnpm check:decisions && pnpm check:invariants && pnpm check:jonction && pnpm check:no-skipped-tests && pnpm check:test-projects && pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "build:packages": "pnpm --recursive --filter \"./packages/**\" build"
  },
  "devDependencies": {
    "@axion/ui": "workspace:*",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {}
    }
  }
}
