    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "react": "18.3.1"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0"
