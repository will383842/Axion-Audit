{
  "name": "@axion/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API REST /v1 (Fastify 5) — seul point d'entrée aux données (02 §4.3-2).",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrations.mjs",
    "db:migrate:check": "node scripts/migrations.mjs --check",
    "db:generate": "node scripts/db-generate.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:demo": "node scripts/seed.mjs --demo"
  },
  "dependencies": {
    "@axion/shared": "workspace:*",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "10.3.0",
    "drizzle-orm": "0.44.7",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "pino": "9.14.0",
    "uuidv7": "1.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1"
  }
}
