# Contrat 11 §1 : versions ÉPINGLÉES, aucune montée majeure sans décision humaine.
# `save-exact` est la traduction littérale de cette règle : pas de ^ ni de ~.
save-exact=true

# Corepack télécharge et impose la version de `packageManager` du package.json (pnpm 9).
manage-package-manager-versions=true

# engine-strict laissé à false DÉLIBÉRÉMENT : la machine de dev porte Node 24 alors que
# le contrat épingle Node 22 LTS. Voir DECISIONS.md 2026-08-27 « Versions Node/pnpm de la
# machine de développement vs contrat §1 » : la vérité d'exécution est la CI et les
# conteneurs (node:22), l'écart local reste visible en avertissement sans bloquer l'amorçage.
engine-strict=false

# Sécurité de la chaîne d'approvisionnement : aucun script post-install n'est exécuté
# automatiquement (les paquets légitimes qui en ont besoin sont listés explicitement).
strict-peer-dependencies=false
